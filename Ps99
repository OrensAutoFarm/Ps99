local activeTween = nil
local targetCheck = nil
local arrivalThreshold = 3
local currentRift = nil
local lastRiftMessage = nil
local hatching = false

local function stopCurrentTween()
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
    setNoClip(false)
    if targetCheck then
        targetCheck:Disconnect()
        targetCheck = nil
    end
end

local function getHumanoidRootPart()
    local character = player.Character or player.CharacterAdded:Wait()
    return character:WaitForChild("HumanoidRootPart")
end

local function hatchEgg(riftName)
    local eggName = EggData[riftName]
    if not eggName then return end
    
    local args = {
        "HatchEgg",
        eggName,
        hatchAmount
    }
    game:GetService("ReplicatedStorage")
        :WaitForChild("Shared")
        :WaitForChild("Framework")
        :WaitForChild("Network")
        :WaitForChild("Remote")
        :WaitForChild("Event")
        :FireServer(unpack(args))
end

local function startHatching(riftName)
    if not hatching then
        hatching = true
        task.spawn(function()
            while currentRift and currentRift.Parent and hatching do
                hatchEgg(riftName)
                task.wait()
            end
            hatching = false
        end)
    end
end

local function tweenToRift(riftName)
    local rift = workspace.Rendered.Rifts:FindFirstChild(riftName)
    if not rift then return false end
    
    local platform = rift:FindFirstChild("EggPlatformSpawn")
    if not platform then return false end
    
    local targetPart = platform:GetChildren()[5]
    if not targetPart or not targetPart:IsA("BasePart") then return false end
    
    local humanoidRootPart = getHumanoidRootPart()
    local targetPosition = targetPart.Position + Vector3.new(0, 3, 0)
    local distance = (humanoidRootPart.Position - targetPosition).Magnitude
    
    if distance <= arrivalThreshold then
        if lastRiftMessage ~= riftName then
            lastRiftMessage = riftName
        end
        startHatching(riftName)
        currentRift = rift
        return true
    end
    
    stopCurrentTween()
    currentRift = rift
    lastRiftMessage = nil
    hatching = false
    
    setNoClip(true)
    
    targetCheck = RunService.Heartbeat:Connect(function()
        if not (currentRift and currentRift.Parent) then
            stopCurrentTween()
            return
        end
        
        local currentDistance = (humanoidRootPart.Position - targetPosition).Magnitude
        if currentDistance <= arrivalThreshold then
            lastRiftMessage = riftName
            stopCurrentTween()
            startHatching(riftName)
        end
    end)
    
    activeTween = TweenService:Create(
        humanoidRootPart,
        TweenInfo.new(
            distance/1000,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out,
            0,
            false
        ),
        {CFrame = CFrame.new(targetPosition)}
    )
    
    activeTween.Completed:Connect(function()
        stopCurrentTween()
    end)
    
    activeTween:Play()
    
    while activeTween do
        task.wait()
    end
    
    return true
end

local riftCheckLoop
Tabs.Rifts:AddToggle("MyToggle", {
    Title = "AutoFarm Rifts", 
    Description = "Stays on one rift until it despawns",
    Default = false,
    Callback = function(state)
        if state then
            local selectedEggs = {}
            for _, displayName in pairs(MultiDropdown:GetActiveValues()) do
                for riftName, eggName in pairs(EggData) do
                    if eggName == displayName then
                        table.insert(selectedEggs, riftName)
                        break
                    end
                end
            end
            
            riftCheckLoop = task.spawn(function()
                while task.wait(0.1) do
                    if currentRift and not currentRift.Parent then
                        currentRift = nil
                        lastRiftMessage = nil
                        hatching = false
                        stopCurrentTween()
                        
                        local riftAvailable = false
                        for _, riftName in pairs(selectedEggs) do
                            if workspace.Rendered.Rifts:FindFirstChild(riftName) then
                                riftAvailable = true
                                break
                            end
                        end
                        
                        if not riftAvailable then
                            local args = {
                                "Teleport",
                                "Workspace.Worlds.The Overworld.FastTravel.Spawn"
                            }
                            game:GetService("ReplicatedStorage")
                                :WaitForChild("Shared")
                                :WaitForChild("Framework")
                                :WaitForChild("Network")
                                :WaitForChild("Remote")
                                :WaitForChild("Event")
                                :FireServer(unpack(args))
                        end
                    end
                    
                    if currentRift and currentRift.Parent then
                        tweenToRift(currentRift.Name)
                        continue
                    end
                    
                    for _, riftName in pairs(selectedEggs) do
                        if tweenToRift(riftName) then
                            break
                        end
                    end
                end
            end)
        else
            if riftCheckLoop then
                task.cancel(riftCheckLoop)
            end
            stopCurrentTween()
            currentRift = nil
            lastRiftMessage = nil
            hatching = false
        end
    end 
})

